# Copy to .env and fill locally. NEVER commit .env or real keys.
# Use Stripe TEST mode values (sk_test_… / price_…) until you deliberately go live.
# See docs/ENV.md and docs/SELLER_SETUP.md.

# Stripe secret key — Dashboard → Developers → API keys (test mode)
STRIPE_SECRET_KEY=sk_test_replace_me

# One Stripe Price ID per catalog SKU (Dashboard → Products → Price ID)
STRIPE_PRICE_CASHFLOW_KIT=price_replace_me
STRIPE_PRICE_INVOICE_PACK=price_replace_me
STRIPE_PRICE_FINANCE_BUNDLE=price_replace_me
STRIPE_PRICE_CLIENT_OPS_KIT=price_replace_me

# Optional local defaults
PORT=4242
PRODUCTS_DIR=./products
SUCCESS_URL=http://localhost:4242/success?session_id={CHECKOUT_SESSION_ID}
CANCEL_URL=http://localhost:4242/
